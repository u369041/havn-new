generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int              @id @default(autoincrement())
  name                     String?
  email                    String           @unique
  password                 String
  role                     UserRole         @default(user)
  createdAt                DateTime         @default(now())
  emailVerified            Boolean          @default(false)
  emailVerifyToken         String?          @unique
  emailVerifyTokenExp      DateTime?
  lastLoginAt              DateTime?
  loginCount               Int              @default(0)
  lastSearch               Json?
  lastSearchAt             DateTime?
  foundingOfferUsedAt      DateTime?
  pendingEmail             String?          @unique
  emailChangeTokenHash     String?          @unique
  emailChangeTokenExp      DateTime?
  passwordChangedAt        DateTime?
  savedSearchEmailsEnabled Boolean          @default(true)
  listingEmailsEnabled     Boolean          @default(true)
  productEmailsEnabled     Boolean          @default(false)
  deletionRequestedAt      DateTime?
  deletionScheduledAt      DateTime?
  deletionCancelledAt      DateTime?
  deletedAt                DateTime?
  approvals                Property[]       @relation("PropertyApprovedBy")
  rejections               Property[]       @relation("PropertyRejectedBy")
  properties               Property[]
  savedSearches            SavedSearch[]
  savedProperties          SavedProperty[]
  analyticsEvents          AnalyticsEvent[]

  passwordResetTokens PasswordResetToken[]

  agentProfile               AgentProfile?  @relation("AgentProfileUser")
  agentApplicationsApproved  AgentProfile[] @relation("AgentApprovedBy")
  agentApplicationsRejected  AgentProfile[] @relation("AgentRejectedBy")
  agentApplicationsSuspended AgentProfile[] @relation("AgentSuspendedBy")
}

model AgentProfile {
  id Int @id @default(autoincrement())

  userId Int @unique

  firstName String
  lastName  String

  companyName String

  addressLine1 String
  addressLine2 String?
  townCity     String
  county       String
  eircode      String

  phoneNumber       String
  psraLicenceNumber String @unique

  status AgentStatus @default(PENDING_APPROVAL)

  declarationAcceptedAt DateTime
  psraVerified          Boolean  @default(false)

  submittedAt DateTime @default(now())

  approvedAt   DateTime?
  approvedById Int?

  rejectedAt     DateTime?
  rejectedById   Int?
  rejectedReason String?

  suspendedAt      DateTime?
  suspendedById    Int?
  suspensionReason String?

  archivedAt DateTime?

  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionStatus AgentSubscriptionStatus @default(NOT_STARTED)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  subscriptionStartedAt        DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCancelledAt      DateTime?

  user        User  @relation("AgentProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("AgentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User? @relation("AgentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  suspendedBy User? @relation("AgentSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([companyName])
  @@index([submittedAt])
  @@index([approvedAt])
  @@index([subscriptionStatus])
  @@index([stripePriceId])
}

model SavedSearch {
  id             Int       @id @default(autoincrement())
  userId         Int
  name           String?
  filters        Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  alertFrequency String    @default("weekly")
  alertsEnabled  Boolean   @default(true)
  lastDigestAt   DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([lastDigestAt])
}

model SavedProperty {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id                      Int              @id @default(autoincrement())
  slug                    String           @unique
  title                   String
  address1                String
  address2                String?
  city                    String
  county                  String
  eircode                 String?
  price                   Int
  ber                     String?
  bedrooms                Int?
  bathrooms               Int?
  features                String[]
  description             String?
  photos                  String[]
  userId                  Int
  berNo                   String?
  createdAt               DateTime         @default(now())
  lat                     Float?
  lng                     Float?
  propertyType            String
  saleType                String?
  updatedAt               DateTime         @updatedAt
  listingStatus           ListingStatus    @default(DRAFT)
  publishedAt             DateTime?
  archivedAt              DateTime?
  approvedAt              DateTime?
  approvedById            Int?
  rejectedAt              DateTime?
  rejectedById            Int?
  submittedAt             DateTime?
  marketStatus            String?
  mode                    MarketMode       @default(BUY)
  rejectedReason          String?
  availableFrom           DateTime?
  berRating               String?
  deposit                 Int?
  furnished               Boolean?
  outdoorSpace            String?
  parking                 String?
  rentFrequency           String?
  size                    Float?
  sizeUnit                String?
  featuredUntil           DateTime?
  isFeatured              Boolean          @default(false)
  views                   Int              @default(0)
  billsIncluded           String?
  couplesAllowed          String?
  currentOccupants        Int?
  ensuite                 String?
  heatingType             String?
  leaseLength             String?
  minimumTerm             String?
  petsAllowed             String?
  roomType                String?
  saleCondition           String?
  viewingDetails          String?
  yearBuilt               Int?
  previousPrice           Int?
  priceDroppedAt          DateTime?
  ownerOccupied           String?
  intelligence            Json?
  intelligenceUpdatedAt   DateTime?
  photoMeta               Json?
  photoMetaUpdatedAt      DateTime?
  listingPackage          ListingPackage?
  paymentStatus           PaymentStatus    @default(UNPAID)
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?
  amountPaidCents         Int?
  paidAt                  DateTime?
  listingExpiresAt        DateTime?
  expiryWarningSentAt     DateTime?
  expiredEmailSentAt      DateTime?
  locationId              Int?
  analyticsEvents         AnalyticsEvent[]
  enquiries               Enquiry[]
  approvedBy              User?            @relation("PropertyApprovedBy", fields: [approvedById], references: [id])
  location                Location?        @relation("PropertyLocation", fields: [locationId], references: [id])
  rejectedBy              User?            @relation("PropertyRejectedBy", fields: [rejectedById], references: [id])
  user                    User             @relation(fields: [userId], references: [id])
  savedBy                 SavedProperty[]

  @@index([userId])
  @@index([locationId])
  @@index([listingStatus])
  @@index([mode])
  @@index([isFeatured])
  @@index([featuredUntil])
  @@index([listingPackage])
  @@index([paymentStatus])
  @@index([listingExpiresAt])
  @@index([expiryWarningSentAt])
  @@index([expiredEmailSentAt])
}

model Enquiry {
  id              Int           @id @default(autoincrement())
  propertyId      Int
  buyerName       String
  buyerEmail      String
  buyerPhone      String?
  message         String
  intent          String?
  sourceUrl       String?
  createdAt       DateTime      @default(now())
  internalNote    String?
  status          EnquiryStatus @default(NEW)
  statusUpdatedAt DateTime?
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([buyerEmail])
  @@index([createdAt])
  @@index([status])
}

model Location {
  id                 Int              @id @default(autoincrement())
  slug               String           @unique
  name               String
  canonicalName      String
  displayName        String
  type               LocationType
  county             String?
  parentId           Int?
  latitude           Float?
  longitude          Float?
  aliases            String[]         @default([])
  searchTerms        String[]         @default([])
  eircodeRoutingKeys String[]         @default([])
  population         Int?
  searchable         Boolean          @default(true)
  indexable          Boolean          @default(false)
  isPopular          Boolean          @default(false)
  isActive           Boolean          @default(true)
  seoPriority        Int              @default(0)
  displayOrder       Int              @default(0)
  tailteId           String?
  csoId              String?
  osmId              String?
  geonamesId         String?
  sourceData         Json?
  boundingBox        Json?
  daftChecked        Boolean          @default(false)
  daftCheckedAt      DateTime?
  daftNotes          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  analyticsEvents    AnalyticsEvent[]
  parent             Location?        @relation("LocationHierarchy", fields: [parentId], references: [id])
  children           Location[]       @relation("LocationHierarchy")
  properties         Property[]       @relation("PropertyLocation")

  @@index([name])
  @@index([canonicalName])
  @@index([displayName])
  @@index([type])
  @@index([county])
  @@index([parentId])
  @@index([searchable])
  @@index([indexable])
  @@index([isPopular])
  @@index([isActive])
  @@index([seoPriority])
  @@index([displayOrder])
  @@index([tailteId])
  @@index([csoId])
  @@index([osmId])
  @@index([geonamesId])
}

model AnalyticsEvent {
  id         BigInt             @id @default(autoincrement())
  createdAt  DateTime           @default(now())
  eventType  AnalyticsEventType
  sessionId  String
  userId     Int?
  propertyId Int?
  locationId Int?
  mode       MarketMode?
  path       String?
  referrer   String?
  userAgent  String?
  ipHash     String?
  payload    Json?
  location   Location?          @relation(fields: [locationId], references: [id])
  property   Property?          @relation(fields: [propertyId], references: [id])
  user       User?              @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventType])
  @@index([sessionId])
  @@index([userId])
  @@index([propertyId])
  @@index([locationId])
  @@index([mode])
  @@index([eventType, createdAt])
  @@index([locationId, eventType, createdAt])
  @@index([propertyId, eventType, createdAt])
}

enum MarketMode {
  BUY
  RENT
  SHARE
}

enum UserRole {
  admin
  agent
  user
}

enum AgentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum AgentSubscriptionStatus {
  NOT_STARTED
  CHECKOUT_PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  REJECTED
  ARCHIVED
  CLOSED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VIEWING_BOOKED
  OFFER_IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum ListingPackage {
  STANDARD
  FEATURED
}

enum PaymentStatus {
  UNPAID
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum LocationType {
  COUNTRY
  COUNTY
  CITY
  TOWN
  VILLAGE
  SUBURB
  NEIGHBOURHOOD
  LOCALITY
  TOWNLAND
  POSTAL_DISTRICT
  SEARCH_REGION
}

enum AnalyticsEventType {
  SEARCH
  PROPERTY_VIEW
  PROPERTY_SAVE
  PROPERTY_CONTACT
  SEARCH_SAVE
  FEATURED_CLICK
  PROPERTY_SHARE
}
