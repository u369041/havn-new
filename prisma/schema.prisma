generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int       @id @default(autoincrement())
  name                     String?
  email                    String    @unique
  password                 String?
  googleId                 String?   @unique
  googleEmail              String?
  googleLinkedAt           DateTime?
  appleId                  String?   @unique
  appleEmail               String?
  appleLinkedAt            DateTime?
  lastAuthProvider         String?
  role                     UserRole  @default(user)
  createdAt                DateTime  @default(now())
  emailVerified            Boolean   @default(false)
  emailVerifyToken         String?   @unique
  emailVerifyTokenExp      DateTime?
  lastLoginAt              DateTime?
  loginCount               Int       @default(0)
  lastSearch               Json?
  lastSearchAt             DateTime?
  foundingOfferUsedAt      DateTime?
  pendingEmail             String?   @unique
  emailChangeTokenHash     String?   @unique
  emailChangeTokenExp      DateTime?
  passwordChangedAt        DateTime?
  savedSearchEmailsEnabled Boolean   @default(true)
  listingEmailsEnabled     Boolean   @default(true)
  productEmailsEnabled     Boolean   @default(false)
  deletionRequestedAt      DateTime?
  deletionScheduledAt      DateTime?
  deletionCancelledAt      DateTime?
  deletedAt                DateTime?

  approvals           Property[]           @relation("PropertyApprovedBy")
  rejections          Property[]           @relation("PropertyRejectedBy")
  properties          Property[]
  savedSearches       SavedSearch[]
  savedProperties     SavedProperty[]
  analyticsEvents     AnalyticsEvent[]
  passwordResetTokens PasswordResetToken[]

  agentProfile               AgentProfile?  @relation("AgentProfileUser")
  agentApplicationsApproved  AgentProfile[] @relation("AgentApprovedBy")
  agentApplicationsRejected  AgentProfile[] @relation("AgentRejectedBy")
  agentApplicationsSuspended AgentProfile[] @relation("AgentSuspendedBy")

  agencyMemberships           AgencyMember[]
  agenciesCreated             Agency[]              @relation("AgencyCreatedBy")
  agenciesUpdated             Agency[]              @relation("AgencyUpdatedBy")
  professionalContactsCreated ProfessionalContact[] @relation("ProfessionalContactCreatedBy")
  professionalContactsUpdated ProfessionalContact[] @relation("ProfessionalContactUpdatedBy")
  inventoryPropertiesCreated  InventoryProperty[]   @relation("InventoryPropertyCreatedBy")
  inventoryPropertiesUpdated  InventoryProperty[]   @relation("InventoryPropertyUpdatedBy")
  inventoryMediaCreated       InventoryMedia[]      @relation("InventoryMediaCreatedBy")
  inventoryMediaUpdated       InventoryMedia[]      @relation("InventoryMediaUpdatedBy")
  agencyAuditEvents           AgencyAuditLog[]      @relation("AgencyAuditActor")
  agencyAuditEffectiveEvents  AgencyAuditLog[]      @relation("AgencyAuditEffectiveUser")
  propertiesCreatedForAgency  Property[]            @relation("PropertyCreatedBy")
  propertiesUpdatedForAgency  Property[]            @relation("PropertyUpdatedBy")
  listingRevisionsSubmitted   ListingRevision[]     @relation("ListingRevisionSubmittedBy")
  listingRevisionsReviewed    ListingRevision[]     @relation("ListingRevisionReviewedBy")
}

model AgentProfile {
  id Int @id @default(autoincrement())

  userId Int @unique

  firstName String
  lastName  String

  companyName String

  addressLine1 String
  addressLine2 String?
  townCity     String
  county       String
  eircode      String

  phoneNumber       String
  psraLicenceNumber String @unique

  status AgentStatus @default(PENDING_APPROVAL)

  declarationAcceptedAt DateTime
  psraVerified          Boolean  @default(false)

  submittedAt DateTime @default(now())

  approvedAt   DateTime?
  approvedById Int?

  rejectedAt     DateTime?
  rejectedById   Int?
  rejectedReason String?

  suspendedAt      DateTime?
  suspendedById    Int?
  suspensionReason String?

  archivedAt DateTime?

  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionStatus AgentSubscriptionStatus @default(NOT_STARTED)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  subscriptionStartedAt        DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCancelledAt      DateTime?

  user        User  @relation("AgentProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("AgentApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy  User? @relation("AgentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  suspendedBy User? @relation("AgentSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([companyName])
  @@index([submittedAt])
  @@index([approvedAt])
  @@index([subscriptionStatus])
  @@index([stripePriceId])
}

model Agency {
  id                Int          @id @default(autoincrement())
  name              String
  legalName         String?
  slug              String       @unique
  psraLicenceNumber String?      @unique
  primaryEmail      String?
  billingEmail      String?
  phoneNumber       String?
  websiteUrl        String?
  addressLine1      String?
  addressLine2      String?
  townCity          String?
  county            String?
  eircode           String?
  status            AgencyStatus @default(ACTIVE)

  createdByUserId Int?
  updatedByUserId Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  createdBy User? @relation("AgencyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AgencyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  members             AgencyMember[]
  contacts            ProfessionalContact[]
  inventoryProperties InventoryProperty[]
  inventoryMedia      InventoryMedia[]
  auditLogs           AgencyAuditLog[]
  properties          Property[]
  listingRevisions    ListingRevision[]

  @@index([name])
  @@index([status])
  @@index([primaryEmail])
  @@index([billingEmail])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model AgencyMember {
  id        Int                @id @default(autoincrement())
  agencyId  Int
  userId    Int
  role      AgencyMemberRole   @default(AGENT)
  status    AgencyMemberStatus @default(ACTIVE)
  jobTitle  String?
  isPrimary Boolean            @default(false)

  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedInventoryProperties InventoryProperty[] @relation("InventoryAssignedMember")
  auditEvents                 AgencyAuditLog[]    @relation("AgencyAuditActorMember")

  @@unique([agencyId, userId])
  @@index([agencyId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@index([agencyId, status])
  @@index([agencyId, role])
}

model ProfessionalContact {
  id       Int @id @default(autoincrement())
  agencyId Int

  firstName   String?
  lastName    String?
  companyName String?

  primaryEmail String?
  phoneNumber  String?
  roles        ProfessionalContactRole[] @default([])

  notes      String?
  isArchived Boolean @default(false)

  createdByUserId Int?
  updatedByUserId Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ProfessionalContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("ProfessionalContactUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  primaryForInventory InventoryProperty[] @relation("InventoryPrimaryContact")

  @@index([agencyId])
  @@index([primaryEmail])
  @@index([phoneNumber])
  @@index([isArchived])
  @@index([agencyId, isArchived])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model InventoryProperty {
  id       Int @id @default(autoincrement())
  agencyId Int

  address1 String
  address2 String?
  city     String
  county   String
  eircode  String?

  propertyType String?
  bedrooms     Int?
  bathrooms    Int?
  size         Float?
  sizeUnit     String?

  transactionType InventoryTransactionType @default(SALE)
  stage           InventoryStage           @default(PROSPECT)

  askingPrice    Int?
  valuationPrice Int?

  listingTitle   String?
  description    String?
  features       String[] @default([])
  berRating      String?
  berNo          String?
  parking        String?
  outdoorSpace   String?
  saleCondition  String?
  yearBuilt      Int?
  heatingType    String?
  viewingDetails String?

  rentFrequency    String?
  deposit          Int?
  availableFrom    DateTime?
  furnished        Boolean?
  leaseLength      String?
  minimumTerm      String?
  billsIncluded    String?
  petsAllowed      String?
  roomType         String?
  ensuite          String?
  currentOccupants Int?
  couplesAllowed   String?
  ownerOccupied    String?

  assignedMemberId Int?
  primaryContactId Int?

  notes String?

  appraisalDate   DateTime?
  instructionDate DateTime?
  readyToListAt   DateTime?
  liveAt          DateTime?
  saleAgreedDate  DateTime?
  letAgreedDate   DateTime?
  completedAt     DateTime?
  withdrawnAt     DateTime?
  lostAt          DateTime?

  createdByUserId Int?
  updatedByUserId Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  agency         Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedMember AgencyMember?        @relation("InventoryAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  primaryContact ProfessionalContact? @relation("InventoryPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  createdBy      User?                @relation("InventoryPropertyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy      User?                @relation("InventoryPropertyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  listings  Property[]
  revisions ListingRevision[]
  media     InventoryMedia[]

  @@index([agencyId])
  @@index([stage])
  @@index([transactionType])
  @@index([assignedMemberId])
  @@index([primaryContactId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([agencyId, stage])
  @@index([agencyId, assignedMemberId])
  @@index([updatedAt])
}

model InventoryMedia {
  id                  Int @id @default(autoincrement())
  inventoryPropertyId Int
  agencyId            Int

  kind       InventoryMediaKind
  source     InventoryMediaSource     @default(CLOUDINARY)
  visibility InventoryMediaVisibility @default(LISTING_ELIGIBLE)

  url          String
  thumbnailUrl String?
  publicId     String?
  resourceType String?
  format       String?
  mimeType     String?

  originalFilename String?
  bytes            Int?
  width            Int?
  height           Int?
  duration         Float?

  title    String?
  caption  String?
  category String?

  position Int     @default(0)
  isCover  Boolean @default(false)

  externalProvider String?

  createdByUserId Int?
  updatedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryProperty InventoryProperty @relation(fields: [inventoryPropertyId], references: [id], onDelete: Cascade)
  agency            Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("InventoryMediaCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy         User?             @relation("InventoryMediaUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([inventoryPropertyId, publicId])
  @@index([inventoryPropertyId])
  @@index([agencyId])
  @@index([kind])
  @@index([visibility])
  @@index([inventoryPropertyId, kind])
  @@index([inventoryPropertyId, position])
  @@index([agencyId, createdAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model AgencyAuditLog {
  id       BigInt @id @default(autoincrement())
  agencyId Int

  actorUserId         Int?
  actorAgencyMemberId Int?
  effectiveUserId     Int?

  action     String
  entityType String
  entityId   String?

  beforeState   Json?
  afterState    Json?
  changedFields Json?
  metadata      Json?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  agency            Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actorUser         User?         @relation("AgencyAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAgencyMember AgencyMember? @relation("AgencyAuditActorMember", fields: [actorAgencyMemberId], references: [id], onDelete: SetNull)
  effectiveUser     User?         @relation("AgencyAuditEffectiveUser", fields: [effectiveUserId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([actorUserId])
  @@index([actorAgencyMemberId])
  @@index([effectiveUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([agencyId, createdAt])
  @@index([agencyId, actorUserId, createdAt])
  @@index([agencyId, entityType, entityId])
}

model SavedSearch {
  id             Int       @id @default(autoincrement())
  userId         Int
  name           String?
  filters        Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  alertFrequency String    @default("weekly")
  alertsEnabled  Boolean   @default(true)
  lastDigestAt   DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([lastDigestAt])
}

model SavedProperty {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id                      Int             @id @default(autoincrement())
  slug                    String          @unique
  title                   String
  address1                String
  address2                String?
  city                    String
  county                  String
  eircode                 String?
  price                   Int
  ber                     String?
  bedrooms                Int?
  bathrooms               Int?
  features                String[]
  description             String?
  photos                  String[]
  userId                  Int
  berNo                   String?
  createdAt               DateTime        @default(now())
  lat                     Float?
  lng                     Float?
  propertyType            String
  saleType                String?
  updatedAt               DateTime        @updatedAt
  listingStatus           ListingStatus   @default(DRAFT)
  publishedAt             DateTime?
  archivedAt              DateTime?
  approvedAt              DateTime?
  approvedById            Int?
  rejectedAt              DateTime?
  rejectedById            Int?
  submittedAt             DateTime?
  marketStatus            String?
  mode                    MarketMode      @default(BUY)
  rejectedReason          String?
  availableFrom           DateTime?
  berRating               String?
  deposit                 Int?
  furnished               Boolean?
  outdoorSpace            String?
  parking                 String?
  rentFrequency           String?
  size                    Float?
  sizeUnit                String?
  featuredUntil           DateTime?
  isFeatured              Boolean         @default(false)
  views                   Int             @default(0)
  billsIncluded           String?
  couplesAllowed          String?
  currentOccupants        Int?
  ensuite                 String?
  heatingType             String?
  leaseLength             String?
  minimumTerm             String?
  petsAllowed             String?
  roomType                String?
  saleCondition           String?
  viewingDetails          String?
  yearBuilt               Int?
  previousPrice           Int?
  priceDroppedAt          DateTime?
  ownerOccupied           String?
  intelligence            Json?
  intelligenceUpdatedAt   DateTime?
  photoMeta               Json?
  photoMetaUpdatedAt      DateTime?
  presentationMedia       Json?
  listingPackage          ListingPackage?
  paymentStatus           PaymentStatus   @default(UNPAID)
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?
  amountPaidCents         Int?
  paidAt                  DateTime?
  listingExpiresAt        DateTime?
  expiryWarningSentAt     DateTime?
  expiredEmailSentAt      DateTime?
  locationId              Int?

  agencyId            Int?
  inventoryPropertyId Int?
  createdByUserId     Int?
  updatedByUserId     Int?

  analyticsEvents AnalyticsEvent[]
  enquiries       Enquiry[]
  savedBy         SavedProperty[]
  revisions       ListingRevision[]

  approvedBy User?     @relation("PropertyApprovedBy", fields: [approvedById], references: [id])
  rejectedBy User?     @relation("PropertyRejectedBy", fields: [rejectedById], references: [id])
  location   Location? @relation("PropertyLocation", fields: [locationId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  agency            Agency?            @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  inventoryProperty InventoryProperty? @relation(fields: [inventoryPropertyId], references: [id], onDelete: SetNull)
  createdByUser     User?              @relation("PropertyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser     User?              @relation("PropertyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([locationId])
  @@index([listingStatus])
  @@index([mode])
  @@index([isFeatured])
  @@index([featuredUntil])
  @@index([listingPackage])
  @@index([paymentStatus])
  @@index([listingExpiresAt])
  @@index([expiryWarningSentAt])
  @@index([expiredEmailSentAt])
  @@index([agencyId])
  @@index([inventoryPropertyId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([agencyId, listingStatus])
}

model ListingRevision {
  id                  Int                   @id @default(autoincrement())
  propertyId          Int
  agencyId            Int?
  inventoryPropertyId Int?
  status              ListingRevisionStatus @default(PENDING)

  source        String
  beforeState   Json
  proposedState Json
  changedFields String[]

  submittedByUserId Int?
  reviewedByUserId  Int?
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agency            Agency?            @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  inventoryProperty InventoryProperty? @relation(fields: [inventoryPropertyId], references: [id], onDelete: SetNull)
  submittedBy       User?              @relation("ListingRevisionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy        User?              @relation("ListingRevisionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([propertyId, status])
  @@index([status])
  @@index([agencyId, status])
  @@index([inventoryPropertyId, status])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@index([submittedAt])
}

model Enquiry {
  id              Int           @id @default(autoincrement())
  propertyId      Int
  buyerName       String
  buyerEmail      String
  buyerPhone      String?
  message         String
  intent          String?
  sourceUrl       String?
  createdAt       DateTime      @default(now())
  internalNote    String?
  status          EnquiryStatus @default(NEW)
  statusUpdatedAt DateTime?
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([buyerEmail])
  @@index([createdAt])
  @@index([status])
}

model Location {
  id                 Int              @id @default(autoincrement())
  slug               String           @unique
  name               String
  canonicalName      String
  displayName        String
  type               LocationType
  county             String?
  parentId           Int?
  latitude           Float?
  longitude          Float?
  aliases            String[]         @default([])
  searchTerms        String[]         @default([])
  eircodeRoutingKeys String[]         @default([])
  population         Int?
  searchable         Boolean          @default(true)
  indexable          Boolean          @default(false)
  isPopular          Boolean          @default(false)
  isActive           Boolean          @default(true)
  seoPriority        Int              @default(0)
  displayOrder       Int              @default(0)
  tailteId           String?
  csoId              String?
  osmId              String?
  geonamesId         String?
  sourceData         Json?
  boundingBox        Json?
  daftChecked        Boolean          @default(false)
  daftCheckedAt      DateTime?
  daftNotes          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  analyticsEvents    AnalyticsEvent[]
  parent             Location?        @relation("LocationHierarchy", fields: [parentId], references: [id])
  children           Location[]       @relation("LocationHierarchy")
  properties         Property[]       @relation("PropertyLocation")

  @@index([name])
  @@index([canonicalName])
  @@index([displayName])
  @@index([type])
  @@index([county])
  @@index([parentId])
  @@index([searchable])
  @@index([indexable])
  @@index([isPopular])
  @@index([isActive])
  @@index([seoPriority])
  @@index([displayOrder])
  @@index([tailteId])
  @@index([csoId])
  @@index([osmId])
  @@index([geonamesId])
}

model AnalyticsEvent {
  id         BigInt             @id @default(autoincrement())
  createdAt  DateTime           @default(now())
  eventType  AnalyticsEventType
  sessionId  String
  userId     Int?
  propertyId Int?
  locationId Int?
  mode       MarketMode?
  path       String?
  referrer   String?
  userAgent  String?
  ipHash     String?
  payload    Json?
  location   Location?          @relation(fields: [locationId], references: [id])
  property   Property?          @relation(fields: [propertyId], references: [id])
  user       User?              @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventType])
  @@index([sessionId])
  @@index([userId])
  @@index([propertyId])
  @@index([locationId])
  @@index([mode])
  @@index([eventType, createdAt])
  @@index([locationId, eventType, createdAt])
  @@index([propertyId, eventType, createdAt])
}

enum MarketMode {
  BUY
  RENT
  SHARE
}

enum UserRole {
  admin
  agent
  user
}

enum AgentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum AgentSubscriptionStatus {
  NOT_STARTED
  CHECKOUT_PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AgencyMemberRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum AgencyMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProfessionalContactRole {
  VENDOR
  BUYER
  LANDLORD
  TENANT
  SOLICITOR
  BROKER
  OTHER
}

enum InventoryTransactionType {
  SALE
  RENTAL
  SHARE
}

enum InventoryMediaKind {
  IMAGE
  VIDEO
  FLOOR_PLAN
  DOCUMENT
}

enum InventoryMediaSource {
  CLOUDINARY
  EXTERNAL_URL
}

enum InventoryMediaVisibility {
  LISTING_ELIGIBLE
  INTERNAL_ONLY
}

enum InventoryStage {
  PROSPECT
  APPRAISAL
  INSTRUCTION
  PREPARING
  READY_TO_LIST
  LIVE
  SALE_AGREED
  LET_AGREED
  SOLD
  LET_COMPLETED
  WITHDRAWN
  LOST
}

enum ListingRevisionStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  REJECTED
  ARCHIVED
  CLOSED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  VIEWING_BOOKED
  OFFER_IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum ListingPackage {
  STANDARD
  FEATURED
}

enum PaymentStatus {
  UNPAID
  PENDING
  COMPLETED
  INCLUDED
  FAILED
  REFUNDED
}

enum LocationType {
  COUNTRY
  COUNTY
  CITY
  TOWN
  VILLAGE
  SUBURB
  NEIGHBOURHOOD
  LOCALITY
  TOWNLAND
  POSTAL_DISTRICT
  SEARCH_REGION
}

enum AnalyticsEventType {
  SEARCH
  PROPERTY_VIEW
  PROPERTY_SAVE
  PROPERTY_CONTACT
  SEARCH_SAVE
  FEATURED_CLICK
  PROPERTY_SHARE
}
